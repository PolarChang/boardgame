+const NO_STORE_HEADERS = { "Cache-Control": "private, no-store" };
+
+async function handleVercelSession(request: Request, gameId: string, savedKey: string) {
+  if (!["GET", "POST", "DELETE"].includes(request.method)) {
+    return NextResponse.json({ error: "找不到操作" }, { status: 404, headers: NO_STORE_HEADERS });
+  }
+  if (request.method !== "GET" && !isSameSiteOrigin(request)) {
+    return NextResponse.json({ error: "請從本站操作" }, { status: 403, headers: NO_STORE_HEADERS });
+  }
+  const key = request.method === "POST" ? request.headers.get("X-Knowledge-Admin") || "" : savedKey;
+  if (!key && request.method === "GET") {
+    return NextResponse.json({ authenticated: false }, { headers: NO_STORE_HEADERS });
+  }
+  if (!key || key.length > 1024) {
+    return NextResponse.json({ error: "請先管理登入" }, { status: 401, headers: NO_STORE_HEADERS });
+  }
+  try {
+    const baseUrl = process.env.KNOWLEDGE_PRIVATE_API_URL || process.env.BOARDGAME_RULES_API_URL;
+    const apiKey = (process.env.KNOWLEDGE_PRIVATE_API_URL ? process.env.KNOWLEDGE_PRIVATE_API_KEY : process.env.RULES_API_KEY) || "";
+    const upstream = await fetch(
+      `${baseUrl}/api/knowledge/games/${encodeURIComponent(gameId)}/editorial/session`,
+      {
+        method: request.method,
+        cache: "no-store",
+        signal: AbortSignal.timeout(10000),
+        headers: { "X-Knowledge-Admin": key, "X-Rules-API-Key": apiKey },
+      }
+    );
+    if (request.method === "GET" && upstream.status === 401) {
+      return NextResponse.json({ authenticated: false }, { headers: NO_STORE_HEADERS });
+    }
+    if (!upstream.ok) {
+      return NextResponse.json(
+        { error: "無法驗證管理登入，請確認密碼或稍後重試" },
+        { status: upstream.status, headers: NO_STORE_HEADERS }
+      );
+    }
+    const data = await upstream.json();
+    if (request.method === "POST" && !/^ksession\.[a-f0-9]{64}$/.test(data.token || "")) {
+      throw new Error("Invalid session");
+    }
+    const response = NextResponse.json({ authenticated: request.method !== "DELETE" }, { headers: NO_STORE_HEADERS });
+    if (request.method !== "GET") {
+      response.cookies.set(sessionCookie, request.method === "DELETE" ? "" : data.token, {
+        httpOnly: true,
+        sameSite: "strict",
+        secure: true,
+        path: "/api/rules",
+        maxAge: request.method === "DELETE" ? 0 : 7200,
+      });
+    }
+    return response;
+  } catch {
+    return NextResponse.json({ error: "管理登入服務暫時無法使用" }, { status: 503, headers: NO_STORE_HEADERS });
+  }
+}
+
+async function handleLocalSession(request: Request, gameId: string, savedKey: string) {
+  if (request.method === "GET") {
+    return NextResponse.json({ authenticated: Boolean(savedKey) }, { headers: NO_STORE_HEADERS });
+  }
+  if (!isSameSiteOrigin(request)) {
+    return NextResponse.json({ error: "請從本站操作" }, { status: 403 });
+  }
+  if (request.method === "DELETE") {
+    revokeSession(request);
+    const response = NextResponse.json({ authenticated: false }, { headers: NO_STORE_HEADERS });
+    response.cookies.set(sessionCookie, "", { httpOnly: true, sameSite: "strict", path: "/api/rules", maxAge: 0 });
+    return response;
+  }
+  if (request.method === "POST") {
+    const key = request.headers.get("X-Knowledge-Admin") || "";
+    if (!key || key.length > 1024) {
+      return NextResponse.json({ error: "請輸入管理密碼" }, { status: 401 });
+    }
+    try {
+      const baseUrl = (process.env.KNOWLEDGE_PRIVATE_API_URL || process.env.BOARDGAME_RULES_API_URL) || "http://localhost:8000";
+      const apiKey = (process.env.KNOWLEDGE_PRIVATE_API_URL ? process.env.KNOWLEDGE_PRIVATE_API_KEY : process.env.RULES_API_KEY) || "";
+      const checked = await fetch(
+        `${baseUrl}/api/knowledge/games/${encodeURIComponent(gameId)}/editorial/history`,
+        {
+          cache: "no-store",
+          signal: AbortSignal.timeout(10000),
+          headers: { "X-Knowledge-Admin": key, "X-Rules-API-Key": apiKey },
+        }
+      );
+      if (!checked.ok) {
+        return NextResponse.json(
+          { error: checked.status === 401 ? "管理密碼不正確" : "無法驗證管理登入" },
+          { status: checked.status }
+        );
+      }
+      const response = NextResponse.json({ authenticated: true }, { headers: NO_STORE_HEADERS });
+      response.cookies.set(sessionCookie, createSession(key), {
+        httpOnly: true,
+        sameSite: "strict",
+        secure: new URL(request.url).protocol === "https:",
+        path: "/api/rules",
+        maxAge: 7200,
+      });
+      return response;
+    } catch {
+      return NextResponse.json({ error: "管理登入服務暫時無法使用" }, { status: 503 });
+    }
+  }
+  return NextResponse.json({ error: "找不到操作" }, { status: 404 });
+}
+
+async function handleLocalReadiness(request: Request, savedKey: string) {
+  const key = savedKey || request.headers.get("X-Knowledge-Admin");
+  if (!key) {
+    return NextResponse.json({ error: "請先管理登入" }, { status: 401, headers: NO_STORE_HEADERS });
+  }
+  const upstream = (process.env.KNOWLEDGE_PRIVATE_API_URL || process.env.BOARDGAME_RULES_API_URL) || "http://localhost:8000";
+  const isLoopback = ["localhost", "127.0.0.1"].includes(new URL(upstream).hostname);
+  if (!process.env.KNOWLEDGE_PRIVATE_API_URL && (process.env.VERCEL === "1" || !isLoopback)) {
+    return NextResponse.json({ error: "此環境未提供本機模型狀態" }, { status: 404, headers: NO_STORE_HEADERS });
+  }
+  try {
+    const apiKey = (process.env.KNOWLEDGE_PRIVATE_API_URL ? process.env.KNOWLEDGE_PRIVATE_API_KEY : process.env.RULES_API_KEY) || "";
+    const response = await fetch(`${upstream}/api/local/readiness`, {
+      cache: "no-store",
+      signal: AbortSignal.timeout(5000),
+      headers: { "X-Knowledge-Admin": key, "X-Rules-API-Key": apiKey },
+    });
+    const payload = response.ok
+      ? await response.json()
+      : { error: response.status === 401 ? "請重新管理登入" : "無法確認本機模型狀態" };
+    return NextResponse.json(payload, { status: response.status, headers: NO_STORE_HEADERS });
+  } catch {
+    return NextResponse.json({ error: "無法連線至本機狀態服務" }, { status: 502, headers: NO_STORE_HEADERS });
+  }
+}
+
+async function handleGoogleDocReader(
+  request: Request,
+  gameId: string,
+  savedKey: string,
+  body: Record<string, unknown> | undefined,
+  privateRules: string,
+  docsReaderKey: string
+) {
+  const origin = new URL(request.url);
+  if (request.headers.get("origin") !== origin.origin) {
+    return NextResponse.json({ error: "請從本站操作" }, { status: 403, headers: NO_STORE_HEADERS });
+  }
+  const managementKey = savedKey || request.headers.get("X-Knowledge-Admin");
+  if (!managementKey) {
+    return NextResponse.json({ error: "請先管理登入" }, { status: 401, headers: NO_STORE_HEADERS });
+  }
+  if (typeof body?.url !== "string" || body.url.length > 2000) {
+    return NextResponse.json({ error: "請提供 Google Docs 文件連結" }, { status: 422, headers: NO_STORE_HEADERS });
+  }
+  const cloud = process.env.BOARDGAME_RULES_API_URL;
+  try {
+    const access = await fetch(
+      new URL(`/api/knowledge/games/${encodeURIComponent(gameId)}/editorial/session`, privateRules),
+      {
+        cache: "no-store",
+        redirect: "error",
+        signal: AbortSignal.timeout(10000),
+        headers: {
+          "X-Knowledge-Admin": managementKey,
+          "X-Rules-API-Key": process.env.KNOWLEDGE_PRIVATE_API_KEY || "",
+        },
+      }
+    );
+    if (access.status === 401 || access.status === 404) {
+      return NextResponse.json({ error: "請先管理登入並確認遊戲存在" }, { status: access.status, headers: NO_STORE_HEADERS });
+    }
+    if (!access.ok || !cloud) throw new Error("Docs reader unavailable");
+    const result = await fetch(new URL("/api/internal/editorial/google-doc", cloud), {
+      method: "POST",
+      cache: "no-store",
+      redirect: "error",
+      signal: AbortSignal.timeout(35000),
+      headers: {
+        "Content-Type": "application/json",
+        "X-Rules-API-Key": process.env.RULES_API_KEY || "",
+        "X-Docs-Reader-Key": docsReaderKey,
+      },
+      body: JSON.stringify({ url: body.url }),
+    });
+    if (result.status === 401 || result.status === 403) throw new Error("Docs reader authorization failed");
+    const data = await result.json();
+    if (result.ok && typeof data.text !== "string") throw new Error("Invalid Docs reader response");
+    return NextResponse.json(
+      result.ok ? { text: data.text } : { error: typeof data.detail === "string" ? data.detail : "無法讀取 Google Docs" },
+      { status: result.status, headers: NO_STORE_HEADERS }
+    );
+  } catch {
+    return NextResponse.json(
+      { error: "Google Docs 讀取服務暫時無法使用，請稍後重試或貼上文字。" },
+      { status: 503, headers: NO_STORE_HEADERS }
+    );
+  }
+}
