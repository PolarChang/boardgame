+    entry.best_players_summary !== undefined ||
+    entry.best_for !== undefined ||
+    entry.bestPlayers !== undefined ||
+    entry.bgg_id !== undefined ||
+    entry.bggId !== undefined ||
+    entry.min_players !== undefined ||
+    entry.minPlayers !== undefined
+  );
+}
