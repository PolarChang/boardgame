+    return entries.every(([, val]) => (val as unknown[]).every(isValidCloudGameCandidate));
+  }
+
+  for (const containerKey of ["games", "data", "items", "results", "entries"]) {
+    if (containerKey in payload) {
+      const candidate = payload[containerKey];
+      return Array.isArray(candidate) && candidate.every(isValidCloudGameCandidate);
+    }
+  }
+
+  const values = Object.values(payload);
+  return values.length > 0 && values.every(isValidCloudGameCandidate);
+}
