+export function reconcileRestoredLocationSearch(
+  currentHref: string,
+  savedState: unknown
+): { updatedUrl: URL; restoredY: number } | null {
+  if (!savedState || typeof savedState !== "object") return null;
+  const candidate = savedState as { search?: unknown; y?: unknown };
+  if (typeof candidate.search !== "string" || typeof candidate.y !== "number" || !Number.isFinite(candidate.y) || candidate.y < 0) {
+    return null;
+  }
+  const url = new URL(currentHref);
+  const hasExplicitNonLibraryParams = [...url.searchParams.keys()].some((key) => key !== "library");
+  const savedParams = new URLSearchParams(candidate.search);
+  savedParams.delete("library");
+  const currentParams = new URLSearchParams(url.search);
+  currentParams.delete("library");
+  savedParams.sort();
+  currentParams.sort();
+
+  if (!hasExplicitNonLibraryParams || savedParams.toString() === currentParams.toString()) {
+    if (url.searchParams.has("library")) {
+      savedParams.set("library", url.searchParams.get("library")!);
+    }
+    url.search = savedParams.toString();
+    return { updatedUrl: url, restoredY: candidate.y };
+  }
+  return null;
+}
