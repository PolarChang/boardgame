+/**
+ * Structured route matchers and security helpers for the editorial API proxy.
+ * Replaces the single 460-character compressed regex with readable, testable predicates.
+ */
+import { createHmac } from "node:crypto";
+
+const GET_IMPORT_SUBPATHS = [
+  /^imports$/,
+  /^imports\/[a-f0-9]{32}\/(?:draft|source|document|context|locations|quality|feedback|answers|questions)$/,
+  /^imports\/[a-f0-9]{32}\/questions\/[a-f0-9]{64}$/,
+  /^imports\/[a-f0-9]{32}\/pages\/[1-9][0-9]*\/image$/,
+  /^imports\/[a-f0-9]{32}\/pages\/[1-9][0-9]*\/blocks\/[1-9][0-9]*\/image$/,
+];
+
+const GET_EDITORIAL_SUBPATHS = [
+  /^$/,
+  /^gemini-usage$/,
+  /^deepseek-usage$/,
+  /^history$/,
+  /^pending$/,
+  /^review\/[a-f0-9]{64}$/,
+  /^versions\/[a-f0-9]{64}$/,
+  /^visuals\/[a-f0-9]{64}$/,
+  /^community$/,
+  /^community\/review$/,
+];
+
+const PUT_SUBPATHS = [
+  /^imports\/staged\/[a-f0-9]{64}\/[0-9]{1,2}$/,
+  /^community\/contributions\/[a-f0-9]{32}\/vote$/,
+];
+
+const POST_IMPORT_SUBPATHS = [
+  /^imports$/,
+  /^imports\/[a-f0-9]{32}\/(?:resume|retry|document|context|ask|feedback|repair|questions)$/,
+  /^imports\/[a-f0-9]{32}\/questions\/[a-f0-9]{64}\/cancel$/,
+];
+
+const POST_EDITORIAL_SUBPATHS = [
+  /^drafts$/,
+  /^submit$/,
+  /^review$/,
+  /^publish$/,
+  /^google-doc$/,
+  /^ask$/,
+  /^visuals\/(?:crop|upload-url|export)$/,
+  /^community\/(?:contributions|comments|reports|review)$/,
+];
+
+export function isAllowedEditorialAction(method: string, path: string): boolean {
+  if (method === "GET") {
+    return (
+      GET_EDITORIAL_SUBPATHS.some((pattern) => pattern.test(path)) ||
+      GET_IMPORT_SUBPATHS.some((pattern) => pattern.test(path))
+    );
+  }
+  if (method === "PUT") {
+    return PUT_SUBPATHS.some((pattern) => pattern.test(path));
+  }
+  if (method === "POST") {
+    return (
+      POST_EDITORIAL_SUBPATHS.some((pattern) => pattern.test(path)) ||
+      POST_IMPORT_SUBPATHS.some((pattern) => pattern.test(path))
+    );
+  }
+  return false;
+}
+
+export function isPublicReadAction(method: string, path: string, searchParams: URLSearchParams): boolean {
+  if (searchParams.get("public") !== "1") return false;
+  if (method === "GET") {
+    return !path || path === "pending" || path.startsWith("visuals/") || path === "community";
+  }
+  if (method === "POST") {
+    return path === "ask" || /^community\/(?:contributions|comments|reports)$/.test(path);
+  }
+  if (method === "PUT") {
+    return /^community\/contributions\/[a-f0-9]{32}\/vote$/.test(path);
+  }
+  return false;
+}
+
+export function isPngStreamAction(method: string, path: string): boolean {
+  if (method !== "GET") return false;
+  if (path.startsWith("visuals/")) return true;
+  return (
+    /^imports\/[a-f0-9]{32}\/pages\/[1-9][0-9]*\/image$/.test(path) ||
+    /^imports\/[a-f0-9]{32}\/pages\/[1-9][0-9]*\/blocks\/[1-9][0-9]*\/image$/.test(path)
+  );
+}
+
+export function isPdfSourceAction(method: string, path: string): boolean {
+  return method === "GET" && /^imports\/[a-f0-9]{32}\/source$/.test(path);
+}
+
+export function isSameSiteOrigin(request: Request): boolean {
+  const url = new URL(request.url);
+  const expectedOrigin = `${url.protocol}//${request.headers.get("host") || url.host}`;
+  return request.headers.get("origin") === expectedOrigin;
+}
+
+/**
+ * Verifies management authorization for knowledge base mutation routes.
+ * - Cookie-authenticated browser writes MUST carry a matching same-site Origin header (403 if missing or mismatched).
+ * - Direct header-authenticated requests carrying a mismatched Origin header are also rejected with 403.
+ * - Unauthenticated requests (missing both session cookie and X-Knowledge-Admin header) are rejected with 401.
+ * - When a direct X-Knowledge-Admin header is supplied without a pre-verified local session cookie,
+ *   or when KNOWLEDGE_PRIVATE_API_URL is configured separately from BOARDGAME_RULES_API_URL,
+ *    verifyKnowledgeAdminUpstream() validates the credential against the authoritative editorial service before forwarding.
+ */
+export function verifyKnowledgeAdminMutation(
+  request: Request,
+  resolvedSessionKey: string
+): { ok: true; adminKey: string; fromSessionCookie: boolean } | { ok: false; status: 401 | 403; error: string } {
+  const origin = request.headers.get("origin");
+  if (resolvedSessionKey) {
+    if (!origin || !isSameSiteOrigin(request)) {
+      return { ok: false, status: 403, error: "請從本站操作" };
+    }
+  } else if (origin && !isSameSiteOrigin(request)) {
+    return { ok: false, status: 403, error: "請從本站操作" };
+  }
+  const adminKey = (resolvedSessionKey || request.headers.get("X-Knowledge-Admin") || "").trim();
+  if (!adminKey || adminKey.length > 1024) {
+    return { ok: false, status: 401, error: "請先管理登入" };
+  }
+  return { ok: true, adminKey, fromSessionCookie: Boolean(resolvedSessionKey) };
+}
+
+export async function verifyKnowledgeAdminUpstream(
+  gameId: string,
+  adminKey: string,
+  action: "rulebooks" | "rulebooks/upload-url" | "rulebooks/import" = "rulebooks"
+): Promise<{ ok: true; forwardedHeaders: Record<string, string> } | { ok: false; status: number; error: string }> {
+  const privateBase = process.env.KNOWLEDGE_PRIVATE_API_URL;
+  const publicBase = process.env.BOARDGAME_RULES_API_URL || "http://localhost:8000";
+  if (!privateBase || new URL(privateBase).origin === new URL(publicBase).origin) {
+    return { ok: true, forwardedHeaders: { "X-Knowledge-Admin": adminKey } };
+  }
+  try {
+    const check = await fetch(
+      new URL(`/api/knowledge/games/${encodeURIComponent(gameId)}/editorial/session`, privateBase),
+      {
+        cache: "no-store",
+        redirect: "error",
+        signal: AbortSignal.timeout(10000),
+        headers: {
+          "X-Knowledge-Admin": adminKey,
+          "X-Rules-API-Key": process.env.KNOWLEDGE_PRIVATE_API_KEY || "",
+        },
+      }
+    );
+    if (check.status === 401 || check.status === 404) {
+      return { ok: false, status: 401, error: "管理登入已失效或密碼不正確" };
+    }
+    if (!check.ok) {
+      return { ok: false, status: 503, error: "無法驗證管理登入" };
+    }
+    const data = await check.json().catch(() => null);
+    if (data?.authenticated !== true) {
+      return { ok: false, status: 401, error: "管理登入已失效或密碼不正確" };
+    }
+    const signingSecret = process.env.KNOWLEDGE_RELEASE_SYNC_KEY || process.env.COMMUNITY_PROXY_SECRET || "";
+    if (signingSecret) {
+      const timestamp = Math.floor(Date.now() / 1000).toString();
+      const signature = createHmac("sha256", signingSecret)
+        .update(`rulebook-admin\n${timestamp}\nPOST\n${gameId}\n${action}`)
+        .digest("hex");
+      return {
+        ok: true,
+        forwardedHeaders: {
+          "X-Knowledge-Admin": "",
+          "X-Knowledge-Admin-Timestamp": timestamp,
+          "X-Knowledge-Admin-Signature": signature,
+        },
+      };
+    }
+    return { ok: true, forwardedHeaders: { "X-Knowledge-Admin": adminKey } };
+  } catch {
+    return { ok: false, status: 503, error: "無法驗證管理登入" };
+  }
+}
