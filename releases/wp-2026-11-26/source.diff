+
+export function resetPicksCache(): void {
+  lastKnownGoodPicks = null;
+}
+
+function isPlainObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function isFiniteNumber(value: unknown): value is number {
+  return typeof value === "number" && Number.isFinite(value);
+}
+
+function isStringArray(value: unknown): value is string[] {
+  return Array.isArray(value) && value.every((item) => typeof item === "string");
+}
+
+function isNumberArray(value: unknown): value is number[] {
+  return Array.isArray(value) && value.every(isFiniteNumber);
+}
+
+function isValidBoardGameNewsEntry(entry: unknown): entry is BoardGameNewsEntry {
+  if (!isPlainObject(entry)) return false;
+  return (
+    typeof entry.bgg_id === "string" &&
+    entry.bgg_id.trim().length > 0 &&
+    typeof entry.name === "string" &&
+    entry.name.trim().length > 0 &&
+    isFiniteNumber(entry.year) &&
+    typeof entry.image === "string" &&
+    typeof entry.thumbnail === "string" &&
+    isFiniteNumber(entry.min_players) &&
+    isFiniteNumber(entry.max_players) &&
+    isFiniteNumber(entry.play_time) &&
+    isFiniteNumber(entry.min_age) &&
+    isFiniteNumber(entry.weight) &&
+    isFiniteNumber(entry.rating) &&
+    isFiniteNumber(entry.users_rated) &&
+    isFiniteNumber(entry.bgg_rank) &&
+    isStringArray(entry.categories) &&
+    isStringArray(entry.mechanics) &&
+    isStringArray(entry.designers) &&
+    isNumberArray(entry.best_players_summary) &&
+    isNumberArray(entry.best_for)
+  );
+}
+
+export function isValidBoardGameNewsData(data: unknown): data is BoardGameNewsData {
+  if (!isPlainObject(data)) return false;
+  const entries = Object.entries(data);
+  if (entries.length === 0) return false;
+  let hasBucket = false;
+  for (const [key, value] of entries) {
+    if (!ALLOWED_PLAYER_BUCKET_KEYS.has(key)) return false;
+    if (!Array.isArray(value)) return false;
+    if (!value.every(isValidBoardGameNewsEntry)) return false;
+    hasBucket = true;
+  }
+  return hasBucket;
+}
+
+function isValidCloudGameCandidate(entry: unknown): boolean {
+  if (!isPlainObject(entry)) return false;
+  if (typeof entry.name !== "string" || entry.name.trim().length === 0) return false;
