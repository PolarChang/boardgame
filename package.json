{
  "name": "boardgame",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint src --ext .ts,.tsx",
    "sync:bgg": "tsx scripts/sync-bgg.ts",
    "test": "vitest run",
    "verify:properties": "vitest run scripts/verification/properties.test.ts scripts/verification/picks-properties.test.ts",
    "verify:differential": "tsx scripts/verification/differential.ts",
    "verify:observe": "node scripts/verification/observe.mjs",
    "verify": "playwright test --config scripts/verification/playwright.config.ts",
    "verify:calibrate": "node scripts/verification/calibrate.mjs",
    "verify:integration": "playwright test --config scripts/verification/integration.config.ts",
    "verify:integration:calibrate": "node scripts/verification/integration-calibrate.mjs",
    "verify:pdf": "playwright test --config scripts/verification/pdf.config.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@notionhq/client": "^2.2.15",
    "axios": "^1.17.0",
    "dotenv": "^17.4.2",
    "fast-xml-parser": "^5.8.0",
    "lucide-react": "^1.23.0",
    "next": "^16.2.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "fast-check": "^4.10.3",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.8"
  }
}
